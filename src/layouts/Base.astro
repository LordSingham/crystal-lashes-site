---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
  jsonLd?: object;
  /** Imagem que pinta a primeira tela desta pagina. Ver o preload no head. */
  preloadImage?: string;
}

const { title, description, image, type = 'website', canonicalUrl, jsonLd, preloadImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#0F2820" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="preload" as="font" href="/fonts/better-signature-regular.ttf" type="font/truetype" crossorigin />
  <link rel="preload" as="font" href="/fonts/lora-latin.woff2" type="font/woff2" crossorigin />
  <link rel="preload" as="font" href="/fonts/montserrat-latin.woff2" type="font/woff2" crossorigin />
  {/* Foto que pinta a primeira tela. Quando ela e fundo de CSS (o caso da hero
      da home), o navegador so descobre que ela existe depois de baixar e ler o
      CSS inteiro, e nao ha elemento onde marcar prioridade. Este preload
      antecipa a descoberta. Medido em 16/08/2026: era o que segurava o LCP.
      DEPOIS das fontes de proposito: a fonte pinta o texto (FCP) e a foto pinta
      o bloco (LCP). Posto antes, o preload roubava a vez da fonte e o FCP em
      producao subia de 1,1s para 2,0s. Sem fetchpriority pelo mesmo motivo:
      basta ser descoberta cedo, nao precisa passar na frente do texto. */}
  {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
  <meta name="robots" content="index, follow" />
  <meta name="google-site-verification" content="daHodLjNirnCRwPLjbXg0jFbCdtuhyKRUmuNbRaVDag" />
  <script is:inline>function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"dfbff131915f0c2998954d70d57a7b61"})});</script>
  <SEO
    title={title}
    description={description}
    image={image}
    type={type}
    canonicalUrl={canonicalUrl}
    jsonLd={jsonLd}
  />
</head>
<body>
  <!-- Meta Pixel 3429007943872141. Criado em 2021 e nunca disparou ate 28/07/2026.
       Nao e pre-requisito do anuncio de click-to-WhatsApp: serve para juntar publico
       de remarketing e publico semelhante daqui alguns meses. Ver /privacidade. -->
  <!-- O fbevents.js tem 105KB e e o maior arquivo da pagina. Carregado junto
       com o resto, ele disputa banda com a foto da primeira tela e segura o
       LCP. Aqui o atalho do fbq nasce na hora e ENFILEIRA o init e o PageView;
       o arquivo de verdade so e buscado quando a pagina termina de carregar,
       ou no primeiro toque, o que vier antes. Quando ele chega, a fila e
       disparada e nenhum evento se perde. Medido em 16/08/2026. -->
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];
    function carrega(){if(f.__fbjs)return;f.__fbjs=1;t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    if(b.readyState==='complete'){setTimeout(carrega,0)}
    else{f.addEventListener('load',function(){setTimeout(carrega,0)})}
    ['pointerdown','keydown','touchstart'].forEach(function(ev){
      f.addEventListener(ev,carrega,{once:!0,passive:!0})})}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '3429007943872141');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=3429007943872141&ev=PageView&noscript=1" alt="" /></noscript>
  <a href="#main-content" class="skip-link">Ir para o conteúdo</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <WhatsAppCTA />
</body>
</html>

<script>
  document.documentElement.classList.add('js-loaded');
  const _obs = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        _obs.unobserve(e.target);
      }
    }),
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => _obs.observe(el));
</script>
